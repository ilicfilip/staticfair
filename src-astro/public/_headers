# Staging noindex — prevent search engines from indexing preview deployments
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# Hashed assets — immutable caching (Astro content-hashed filenames)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# HTML and other content — short cache, always revalidate
/*
  Cache-Control: public, max-age=0, must-revalidate
