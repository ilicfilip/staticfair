---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Blog — FAIR"
  description="News, release notes, and updates from the FAIR project — Federated and Independent Repositories for WordPress and beyond."
>
  <section class="max-w-3xl mx-auto px-4 py-12 sm:py-16">
    <h1 class="text-dark-blue mb-8">Blog</h1>
    <div class="space-y-8">
      {posts.map((post) => {
        const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        });
        return (
          <article class="border-b border-light-gray pb-8 last:border-b-0">
            <h2 class="text-xl sm:text-2xl font-bold">
              <a
                href={`/blog/${post.id}/`}
                class="text-dark-blue hover:text-blue transition-colors"
              >
                {post.data.title}
              </a>
            </h2>
            <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-dark-gray text-sm">
              <time datetime={post.data.pubDate.toISOString()}>
                {formattedDate}
              </time>
              {post.data.author && (
                <span>by {post.data.author}</span>
              )}
            </div>
            <p class="mt-3 text-dark-gray leading-relaxed">
              {post.data.description}
            </p>
            <a
              href={`/blog/${post.id}/`}
              class="mt-3 inline-block text-blue hover:text-dark-blue font-medium transition-colors"
            >
              Read more →
            </a>
          </article>
        );
      })}
    </div>
  </section>
</BaseLayout>
