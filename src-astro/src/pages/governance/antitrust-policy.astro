---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildWebPage, buildBreadcrumbs, buildGraph, SITE_URL } from '../../utils/structured-data';

const jsonLd = buildGraph(
  buildWebPage({ name: 'Antitrust Policy', description: "The FAIR Package Manager follows the Linux Foundation's Antitrust Policy to ensure fair, open collaboration and compliance with competition laws.", url: `${SITE_URL}/governance/antitrust-policy/` }),
  buildBreadcrumbs([{ name: 'Home', url: SITE_URL }, { name: 'Governance', url: `${SITE_URL}/governance/` }, { name: 'Antitrust Policy' }]),
);
---

<BaseLayout
  title="Antitrust Policy — FAIR"
  description="The FAIR Package Manager follows the Linux Foundation's Antitrust Policy to ensure fair, open collaboration and compliance with competition laws."
  jsonLd={jsonLd}
>
  <section class="bg-white">
    <div class="max-w-4xl mx-auto px-4 py-16">
      <div class="prose">
        <h1 class="text-dark-blue">Antitrust Policy</h1>

        <p>The FAIR Package Manager follows the Linux Foundation's Antitrust Policy, which ensures that all project activities comply with applicable competition laws. The policy is designed to protect participants from antitrust risks, encourage fair and open collaboration, and prevent anti-competitive practices in meetings, membership, and standards development.</p>

        <p><a href="https://www.linuxfoundation.org/legal/antitrust-policy" rel="noopener noreferrer" target="_blank">Antitrust Policy at Linux Foundation Projects<span class="sr-only"> (opens in new tab)</span></a></p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .prose :global(h1) {
    margin-bottom: 1.5rem;
  }
  .prose :global(p) {
    margin-bottom: 1rem;
    line-height: 1.7;
  }
  .prose :global(a) {
    color: var(--color-blue);
    text-decoration: underline;
  }
  .prose :global(a:hover) {
    color: var(--color-dark-blue);
  }
</style>
