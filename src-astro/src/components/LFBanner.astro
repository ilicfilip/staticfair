---
/**
 * LFBanner — Linux Foundation attribution strip.
 * Dark bar above the main header, required for LF-hosted projects.
 */
---

<div class="bg-[#232323] text-sm py-1.5 px-4" data-focus-dark>
  <div class="max-w-7xl mx-auto flex justify-end">
    <a
      href="https://www.linuxfoundation.org/"
      rel="noopener noreferrer"
      target="_blank"
      class="text-gray-300 hover:text-white transition-colors"
    >
      A Linux Foundation Project<span class="sr-only"> (external link)</span>
    </a>
  </div>
</div>
