---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  author?: string;
  tags?: string[];
  image?: string;
}

const { title, description, pubDate, author, tags, image } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={`${title} — FAIR`}
  description={description}
  ogType="article"
  ogImage={image}
>
  <article class="max-w-3xl mx-auto px-4 py-12 sm:py-16">
    <header class="mb-8 border-b border-light-gray pb-8">
      <h1 class="text-dark-blue">{title}</h1>
      <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-dark-gray text-base">
        <time datetime={pubDate.toISOString()}>
          {formattedDate}
        </time>
        {author && (
          <span>
            <span class="sr-only">Author:</span>
            by {author}
          </span>
        )}
      </div>
      {tags && tags.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2 list-none p-0" aria-label="Post tags">
          {tags.map((tag) => (
            <li class="bg-light-gray text-dark-gray text-sm px-3 py-1 rounded-full">
              {tag}
            </li>
          ))}
        </ul>
      )}
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .prose :global(h2) {
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: var(--color-dark-blue);
  }
  .prose :global(h3) {
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    color: var(--color-dark-blue);
  }
  .prose :global(p) {
    margin-bottom: 1rem;
    line-height: 1.7;
  }
  .prose :global(ul) {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
    list-style-type: disc;
  }
  .prose :global(ol) {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
    list-style-type: decimal;
  }
  .prose :global(li) {
    margin-bottom: 0.5rem;
  }
  .prose :global(a) {
    color: var(--color-blue);
    text-decoration: underline;
  }
  .prose :global(a:hover) {
    color: var(--color-dark-blue);
  }
  .prose :global(code) {
    background-color: var(--color-light-gray);
    padding: 0.15rem 0.35rem;
    border-radius: 0.25rem;
    font-size: 0.9em;
  }
  .prose :global(pre) {
    background-color: var(--color-light-gray);
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin-bottom: 1rem;
  }
  .prose :global(pre code) {
    background: none;
    padding: 0;
  }
  .prose :global(blockquote) {
    border-left: 4px solid var(--color-dark-blue);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--color-dark-gray);
  }
</style>
